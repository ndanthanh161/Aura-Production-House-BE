# DATABASE CONFIGURATION
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=AuraProductionDB

# CONNECTION STRING FOR API
DB_CONNECTION_STRING=Host=db;Port=5432;Database=AuraProductionDB;Username=your_db_user_here;Password=your_secure_password_here

# REDIS CONFIGURATION
REDIS_URL=redis:6379

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:7283/api

# AUTH SECRETS
JWT_SECRET=your_jwt_secret_here

# GOOGLE AUTH
GOOGLE_CLIENT_ID=your_google_client_id_here

# MAIL SETTINGS
MAIL_USER=your_email_here
MAIL_PASSWORD=your_email_app_password_here

# AI SETTINGS
OPENAI_API_KEY=your_openai_api_key_here

# SEPAY SETTINGS
SEPAY_API_KEY=your_sepay_api_key_here

# CLOUDINARY SETTINGS
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
